{:paths   ["src"]
 :deps    {org.clojure/clojure       {:mvn/version "1.12.6"}
           clj-http/clj-http         {:mvn/version "3.13.1"}
           cheshire/cheshire         {:mvn/version "6.2.1"}
           org.clojure/tools.logging {:mvn/version "1.3.1"}
           com.github.ivarref/yasp   {:git/sha "92b59d0cf16d434e760b93759b0a7c89025de855"}
           org.slf4j/slf4j-simple    {:mvn/version "2.0.20"}
           babashka/process          {:mvn/version "0.6.25"}
           org.jline/jline           {:mvn/version "3.23.0"}}

 :aliases {:test     {:extra-paths ["test"]
                      :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                                    org.clj-commons/pretty               {:mvn/version "3.10.0"}
                                    com.github.ivarref/locksmith         {:mvn/version "0.1.9"}
                                    aleph/aleph                          {:mvn/version "0.9.11"}}
                      :main-opts   ["-m" "cognitect.test-runner"]
                      :exec-fn     cognitect.test-runner.api/test}}}
